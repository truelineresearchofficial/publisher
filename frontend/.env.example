# Frontend build-time env (Vite). Copy to `.env` for local dev.
# These values are embedded into the client bundle — do not put secrets here.

# Base URL for the FastAPI submissions API. Defaults to /api (same-origin) if unset.
VITE_API_BASE=/api

# Google Apps Script Web App endpoint that appends Contact submissions to the
# team's Google Sheet. Public web-app URL (ends in /exec).
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyjk2rbkJIXwyao9ThUFPRoLRXOumH7-yhB8hAGhY1S_0rTRo3FOfYGMGBIZdNwu7WAqQ/exec
